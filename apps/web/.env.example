# Copy to .env and fill in:  cp .env.example .env

# Claude key. Leave the placeholder to run in free "mock mode".
ANTHROPIC_API_KEY=sk-ant-...

# Which sandbox runs the code:
#   docker  -> your self-hosted Docker containers (default; needs Colima running)
#   vercel  -> managed Firecracker microVMs via @vercel/sandbox
SANDBOX_BACKEND=docker

# API port (default 3001)
PORT=3001

# VERCEL_OIDC_TOKEN is NOT set here — run `vercel env pull .env.local` to get it.
