# Copy to .env and fill in:  cp .env.example .env

# Claude key. Leave the placeholder to run in free "mock mode".
ANTHROPIC_API_KEY=sk-ant-...

# Which sandbox runs the code:
#   docker  -> your self-hosted Docker containers (default; needs Colima running)
#   vercel  -> managed Firecracker microVMs via @vercel/sandbox
SANDBOX_BACKEND=docker

# API port (default 3001)
PORT=3001

# GitHub — required for the coding agent to clone private repos, push, and open PRs.
# Use a fine-grained PAT scoped to the repo(s) you allow, with:
#   Repository permissions → Contents: Read and write, Pull requests: Read and write
# Without it the agent can still clone/build PUBLIC repos but cannot push or open PRs.
GITHUB_TOKEN=github_pat_...
GIT_AUTHOR_NAME=AI Sandbox Bot
GIT_AUTHOR_EMAIL=ai-sandbox-bot@users.noreply.github.com

# VERCEL_OIDC_TOKEN is NOT set here — run `vercel env pull .env.local` to get it.
